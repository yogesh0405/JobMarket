{
  "name": "csn-jobmarket",
  "version": "1.0.0",
  "private": true,
  "description": "JobMarket Monorepo Platform",
  "scripts": {
    "dev": "npm --prefix App run dev",
    "dev:backend": "npm --prefix backend run dev",
    "dev:all": "npm --prefix backend run dev & npm --prefix App run dev",
