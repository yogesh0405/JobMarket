# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (PostgreSQL / NeonDB)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=verify-full

# Redis Configuration
REDIS_URL=redis://localhost:6379

# JWT Authentication Secrets
JWT_ACCESS_SECRET=your_jwt_access_secret_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_here
JWT_ACCESS_EXPIRES_IN=1d
JWT_REFRESH_EXPIRES_IN=7d

# Brevo (Sendinblue) Email API Configuration
BREVO_API_KEY=your_brevo_api_key_here
SENDER_EMAIL=your_sender_email@domain.com

# Cloudinary Storage Configuration
CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name

# CORS Configuration (Comma-separated origins)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:4173

# AWS S3 Storage Configuration
AWS_ACCESS_KEY_ID=your_aws_access_key_id_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key_here
AWS_REGION=ap-south-1
AWS_S3_BUCKET_NAME=your_s3_bucket_name_here
