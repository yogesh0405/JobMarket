{
  "expo": {
    "name": "JobMarket",
    "slug": "csn-jobmarket",
    "scheme": "jobmarket",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.jobmarket.mobileapp",
      "associatedDomains": [
        "applinks:job-market-wine.vercel.app",
        "applinks:jobmarket-ongn.onrender.com"
      ],
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "JobMarket requires access to your photo library to let you upload profile pictures and resume documents.",
        "NSCameraUsageDescription": "JobMarket requires access to your camera to take profile photos."
      }
    },
    "android": {
      "package": "com.jobmarket.mobileapp",
      "splash": {
        "image": "./assets/icon.png",
        "resizeMode": "contain",
        "backgroundColor": "#FFFFFF"
      },
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/android-icon-foreground.png"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.RECORD_AUDIO"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "job-market-wine.vercel.app",
              "pathPrefix": "/job"
            },
            {
              "scheme": "https",
              "host": "job-market-wine.vercel.app",
              "pathPrefix": "/jobs"
            },
            {
              "scheme": "https",
              "host": "jobmarket-ongn.onrender.com",
              "pathPrefix": "/job"
            },
            {
              "scheme": "https",
              "host": "jobmarket-ongn.onrender.com",
              "pathPrefix": "/jobs"
            },
            {
              "scheme": "jobmarket"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "JobMarket requires access to your photo library to let you upload profile pictures and resume documents.",
          "cameraPermission": "JobMarket requires access to your camera to take profile photos."
        }
      ],
      "expo-secure-store",
      "expo-font",
      "@react-native-community/datetimepicker",
      "expo-sharing"
    ],
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "experiments": {
      "autolinkingModuleResolution": false,
      "tsconfigPaths": true
    },
    "owner": "insightforges-team",
    "extra": {
      "eas": {
        "projectId": "0dffde1a-d3aa-46e6-b42e-379ed7312736"
      }
    }
  }
}
